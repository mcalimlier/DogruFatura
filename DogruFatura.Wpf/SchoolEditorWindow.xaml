<Window x:Class="DogruFatura.Wpf.SchoolEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurum Kaydı" Width="760" Height="590" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Navy950Brush}"
        Language="tr-TR" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="EditorHeading" Text="Yeni Kurum Kaydı" Foreground="#FFD36F" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="Bilgiler yalnız Kaydet ile kalıcı kayda aktarılır." Foreground="#B9CBDA" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PaymentMetricCard}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Kurum Türü *" Style="{StaticResource PremiumFieldLabel}"/><ComboBox x:Name="TypeBox" Style="{StaticResource PremiumFieldComboBox}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Okul / Kurum Adı *" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="NameBox" Style="{StaticResource PremiumFieldTextBox}" MaxLength="200"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3"><TextBlock Text="Vergi Kimlik No" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="VknBox" Style="{StaticResource PremiumFieldTextBox}" MaxLength="10"/></StackPanel>
                    <StackPanel Grid.Row="4"><TextBlock Text="Elektrik Hizmet No" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="ElectricityBox" Style="{StaticResource PremiumFieldTextBox}" MaxLength="50"/></StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Telefon Hizmet No" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="TelephoneBox" Style="{StaticResource PremiumFieldTextBox}" MaxLength="50"/></StackPanel>
                    <StackPanel Grid.Row="6"><TextBlock Text="İnternet Hizmet No" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="InternetBox" Style="{StaticResource PremiumFieldTextBox}" MaxLength="50"/></StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="2"><TextBlock Text="Su Hizmet No" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="WaterBox" Style="{StaticResource PremiumFieldTextBox}" MaxLength="50"/></StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FFB4AD" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Style="{StaticResource GoldActionButton}" Content="Kaydet" IsDefault="True" MinWidth="110" Click="Save_Click" Margin="0,0,10,0"/>
                <Button x:Name="CancelButton" Style="{StaticResource ModernButton}" Background="#315371" Content="Vazgeç" MinWidth="110" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
