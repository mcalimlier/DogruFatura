<Window x:Class="DogruFatura.Wpf.HistoricalPdfImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoğruFatura - Arşiv Ekle"
        Width="1120" Height="620" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" Background="#031C38"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border BorderBrush="#FFB41F" BorderThickness="1.5" CornerRadius="12" Background="#F4F7FA">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>

            <Border Background="#031C38" CornerRadius="10,10,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ARŞİV EKLE ÖNİZLEMESİ" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="SummaryText" Text="Dosyalar doğrulanıyor." Foreground="#B9CBDA" FontSize="13.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="42" Height="42"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="Cancel_Click" ToolTip="Kapat">
                        <Grid Width="18" Height="18" IsHitTestVisible="False">
                            <Path Data="M 3,3 L 15,15 M 15,3 L 3,15"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,12">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#CCD8E3" BorderThickness="1" CornerRadius="9" Padding="1">
                    <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Items}" Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserSortColumns="False" CanUserReorderColumns="False" RowHeight="38" FontSize="14"
                              SelectionChanged="PreviewGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dosya" Binding="{Binding FileName}" Width="190"/>
                            <DataGridTextColumn Header="Ödeme Emri No" Binding="{Binding HysNumber}" Width="155"/>
                            <DataGridTextColumn Header="Tür" Binding="{Binding InvoiceType}" Width="80"/>
                            <DataGridTextColumn Header="Adet" Binding="{Binding InvoiceCountText}" Width="82"/>
                            <DataGridTextColumn Header="Ödeme" Binding="{Binding PaymentTotalText}" Width="115"/>
                            <DataGridTextColumn Header="Tarama" Binding="{Binding ScanDetail}" Width="205"/>
                            <DataGridTextColumn Header="Sonuç" Binding="{Binding ResultText}" Width="125"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border Grid.Row="1" Background="#E8F0F7" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                    <TextBlock x:Name="SelectedDetailText" Text="Ayrıntı için bir dosya seçin." Foreground="#315371" FontSize="13.5" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#082744" CornerRadius="0,0,10,10">
                <Grid Margin="18,0">
                    <TextBlock Text="Hatalı dosyalar eklenmez; geçerli dosyalar tek işlemde arşive kaydedilir."
                               Foreground="#B9CBDA" FontSize="13.5" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernButton}" Content="VAZGEÇ" Width="120" Background="#315371" Margin="0,0,10,0" Click="Cancel_Click"/>
                        <Button x:Name="ConfirmButton" Style="{StaticResource ModernButton}" Content="GEÇERLİLERİ EKLE" Width="190" Background="#248A50" Click="Confirm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
