<Window x:Class="DogruFatura.Wpf.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/AppIcon.ico"
        Title="DoğruFatura"
        Width="430" Height="645" MinWidth="430" MaxWidth="430" MinHeight="645" MaxHeight="645"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#00152D" ShowInTaskbar="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Viewbox Stretch="Uniform">
        <Border Width="600" Height="900" CornerRadius="23" BorderBrush="#FFB41F" BorderThickness="2.2" Margin="18">
            <Border.Background>
                <RadialGradientBrush Center="0.38,0.24" GradientOrigin="0.38,0.24" RadiusX="0.88" RadiusY="0.72">
                    <GradientStop Color="#0A3B73" Offset="0"/>
                    <GradientStop Color="#03254A" Offset="0.35"/>
                    <GradientStop Color="#00152D" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
                <Canvas Opacity="0.20">
                    <Path Stroke="#1794FF" StrokeThickness="1" Data="M0,82 L190,275 L330,126 L505,315 L600,210"/>
                    <Path Stroke="#1794FF" StrokeThickness="1" Data="M35,0 L242,210 L360,85 L560,284"/>
                    <Path Stroke="#FFB41F" StrokeThickness="1" Data="M0,710 Q155,600 302,760 T600,690"/>
                    <Path Stroke="#1794FF" StrokeThickness="1" Data="M0,765 Q190,640 355,805 T600,735"/>
                </Canvas>

                <StackPanel VerticalAlignment="Top" Margin="0,126,0,0" HorizontalAlignment="Center">
                    <Grid Width="420" Height="118">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="Assets/AppIcon_512.png" Width="106" Height="106" Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="48" FontWeight="Bold" HorizontalAlignment="Left">
                                <Run Text="Doğru" Foreground="White"/><Run Text="Fatura" Foreground="#FFB41F"/>
                            </TextBlock>
                            <TextBlock Text="Fatura Ödeme ve Kontrol Programı" Foreground="#E8EEF5" FontSize="16" Margin="3,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border Background="#D9041C36" BorderBrush="#25496B" BorderThickness="1" CornerRadius="14" Width="515" Height="138" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,376,0,0">
                    <StackPanel Width="470" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="30" Height="30" Margin="0,0,13,0">
                                <Ellipse Stroke="#344C67" StrokeThickness="3"/>
                                <Path Stroke="#FFB41F" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M15,1 A14,14 0 0 1 29,15">
                                    <Path.RenderTransform><RotateTransform x:Name="SpinnerRotate" CenterX="15" CenterY="15"/></Path.RenderTransform>
                                </Path>
                            </Grid>
                            <TextBlock Text="DoğruFatura hazırlanıyor..." Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="StageText" Text="Başlangıç denetimleri hazırlanıyor..." Foreground="#B8C6D8" FontSize="13.5" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel VerticalAlignment="Top" Margin="0,607,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="120" Height="1.5" Background="#B77E0A" VerticalAlignment="Center"/>
                        <TextBlock Text="Created by" Foreground="#FFB41F" FontSize="20" Margin="18,0"/>
                        <Border Width="120" Height="1.5" Background="#B77E0A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Murat ÇALIMLIER" Foreground="#FFB41F" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock x:Name="VersionText" Text="v1.0.0 RC1" Foreground="#9FB5C8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Viewbox>
</Window>
