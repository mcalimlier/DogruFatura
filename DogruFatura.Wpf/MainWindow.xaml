<Window x:Class="DogruFatura.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/AppIcon.ico"
        Title="DoğruFatura - Fatura Ödeme ve Kontrol Programı"
        Width="1305" Height="850.5" SizeToContent="Manual" ResizeMode="NoResize"
        WindowStartupLocation="Manual" WindowStyle="None" ShowInTaskbar="True" Background="White"
        UseLayoutRounding="True" SnapsToDevicePixels="True" StateChanged="Window_StateChanged">
    <Viewbox x:Name="AppScaleViewbox" Stretch="Uniform" StretchDirection="Both">
        <Border Width="1450" Height="945" CornerRadius="15" BorderBrush="#35546F" BorderThickness="1" Background="#031C38" Margin="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- ÜST BAR -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#031C38" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="255"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="Assets/Logo.png" Width="220" Stretch="Uniform"
                           Margin="22,0,0,0" HorizontalAlignment="Left"/>

                    <Border Grid.Column="1"
                            Width="148"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#092746"
                            CornerRadius="8"
                            BorderBrush="#24496B"
                            BorderThickness="1"
                            Padding="10,6"
                            Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="HESAPLAMA" Foreground="#8FA8C0" FontSize="10.5" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="#43C77A" Margin="0,0,6,0"/>
                                <TextBlock x:Name="EngineStatusText" Text="Doğrulandı" Foreground="#DDF6E7"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="116"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#082744"
                                BorderBrush="#24496B"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11,6">
                            <StackPanel>
                                <TextBlock Text="AKTİF KURUM" Foreground="#8FA8C0" FontSize="10.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActiveInstitutionText" Text="Henüz seçilmedi" Foreground="White"
                                           FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    ToolTip="Kurum, VKN, fatura türü, hizmet no, fatura no, tarihler, tutar ve geçerli vergi hesabına göre canlı form hazırlığı">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="FORM" Foreground="#8FA8C0" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="HAZIRLIK" Foreground="White" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Grid Width="48" Height="48">
                                <Ellipse Stroke="#29445F" StrokeThickness="5"/>
                                <Path x:Name="HeaderReadinessArc" Stroke="#FFB41F" StrokeThickness="5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock x:Name="HeaderReadinessText" Text="%0" Foreground="White" FontSize="12.5"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="6"
                                Style="{StaticResource ModernButton}"
                                Content="TEMİZLE"
                                Width="116"
                                Height="42"
                                Padding="8,8"
                                Background="#8A5A12"
                                Click="ClearInvoiceForm_Click"/>

                        <Border Grid.Column="2"
                                Background="#082744"
                                BorderBrush="#24496B"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11,6">
                            <StackPanel>
                                <TextBlock Text="SÜRÜM" Foreground="#8FA8C0" FontSize="10.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeaderVersionText"
                                           Text="v—"
                                           Foreground="White"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="8" Style="{StaticResource StandardButtonBase}" Content="—" ToolTip="Küçült" FontSize="23.5" FontWeight="SemiBold" Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="42" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeRestoreButton" Grid.Column="9" Style="{StaticResource StandardButtonBase}" ToolTip="Tam ekran" Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="42" Click="MaximizeRestore_Click">
                            <TextBlock x:Name="MaximizeRestoreIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE922;" FontSize="16.5" FontWeight="SemiBold"/>
                        </Button>
                        <Button Grid.Column="10" Style="{StaticResource StandardButtonBase}" Content="×" ToolTip="Kapat" FontSize="27.5" Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="42" Click="Close_Click"/>
                    </Grid>
                </Grid>

                <!-- SOL MENÜ -->
                <Grid Grid.Row="1" Grid.Column="0" Background="#031C38">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="92"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,12,0,0">
                        <Button x:Name="NavHome" Style="{StaticResource NavButton}" Tag="Active" Click="NavHome_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="22" Width="42"/><TextBlock Text="ANA EKRAN" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="16,8" CornerRadius="1.5"/>
                        <Button x:Name="NavInvoice" Style="{StaticResource NavButton}" Click="NavInvoice_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="22" Width="42"/><TextBlock Text="FATURA GİRİŞİ" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavOfficials" Style="{StaticResource NavButton}" Click="NavOfficials_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="22" Width="42"/><TextBlock Text="YETKİLİ / İMZA" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavList" Style="{StaticResource NavButton}" Click="NavList_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" FontSize="22" Width="42"/><TextBlock Text="FATURA LİSTESİ" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavReports" Style="{StaticResource NavButton}" Click="NavReports_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="22" Width="42"/><TextBlock Text="RAPORLAR / ÇIKTI" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="16,8" CornerRadius="1.5"/>
                        <Button x:Name="NavSchools" Style="{StaticResource NavButton}" Click="NavSchools_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" FontSize="22" Width="42"/><TextBlock Text="OKUL / KURUM" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavArchive" Style="{StaticResource NavButton}" Click="NavArchive_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="22" Width="42"/><TextBlock Text="İŞLEM ARŞİVİ" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavControl" Style="{StaticResource NavButton}" Click="NavControl_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="22" Width="42"/><TextBlock Text="KONTROL MERKEZİ" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavStatistics" Style="{StaticResource NavButton}" Click="NavStatistics_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="22" Width="42"/><TextBlock Text="İSTATİSTİK" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Click="NavAbout_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="22" Width="42"/><TextBlock Text="HAKKINDA / GÜVENLİK" Style="{StaticResource NavLabel}"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="18,7,18,10" Padding="14,9" CornerRadius="9" Background="#082845" BorderBrush="#73581E" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Created by" Foreground="#A8BCD0" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Murat ÇALIMLIER" Foreground="#FFB41F" FontSize="21.5" FontWeight="Bold" Margin="0,2,0,0"/>
                            <Border Height="2" Width="74" Background="#FFB41F" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- İÇERİK -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="13,0,13,0" Padding="20">
                    <Grid>
                        <!-- ANA EKRAN -->
                        <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
                            <StackPanel Margin="0,0,8,16">
                                <TextBlock Text="DOĞRUFATURA YÖNETİM PANELİ" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="HYS ile kapanmış ödeme listelerinin mali durumunu tek bakışta izleyin." Style="{StaticResource PageSubtitle}"/>

                                <Border Style="{StaticResource PremiumPanel}" CornerRadius="10" Padding="20,16" Margin="0,0,0,12"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#1D4B70" CornerRadius="10" Padding="9,4" Margin="0,0,10,0" Visibility="Collapsed"><TextBlock Text="AŞAMA 10 • R2" Foreground="#D9E9F6" FontSize="14" FontWeight="Bold"/></Border>
                                                <TextBlock Text="AKILLI ÖZET" Foreground="#FFC75B" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="Ödeme hareketlerinizi tek bakışta görün" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,9,20,0"/>
                                            <TextBlock Text="Aylık tutarlar, altı aylık eğilim ve fatura türü dağılımı yalnız HYS numarası girilerek kapatılmış arşivlerden hesaplanır." Foreground="#C5D7E7" FontSize="14.5" TextWrapping="Wrap" Margin="0,6,24,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                                <Border Background="#0B3A60" BorderBrush="#365874" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,0"><TextBlock x:Name="HomeTotalInvoiceSummaryText" Text="0 toplam fatura" Foreground="#D8E4EF" FontSize="13.5" FontWeight="SemiBold"/></Border>
                                                <Border Background="#0B3A60" BorderBrush="#365874" BorderThickness="1" CornerRadius="8" Padding="12,7"><TextBlock x:Name="HomeTotalInstitutionSummaryText" Text="0 kurum hareketi" Foreground="#D8E4EF" FontSize="13.5" FontWeight="SemiBold"/></Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="10" Padding="17,13" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock x:Name="HomeMonthLabelText" Text="BU AY" Foreground="#91ABC0" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="HomeMonthPaymentText" Text="0,00 TL" Foreground="#FFB41F" FontSize="29" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                <TextBlock Text="Toplam ödeme" Foreground="#DCE9F4" FontSize="13.5" HorizontalAlignment="Right"/>
                                                <Border Height="1" Background="#315371" Margin="0,10,0,8"/>
                                                <Grid>
                                                    <TextBlock Text="DENETİM" Foreground="#91ABC0" FontSize="12.5" FontWeight="Bold"/>
                                                    <TextBlock x:Name="HomeControlStatusText" Text="TARANIYOR" Foreground="#FFB41F" FontSize="14.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <Border Background="#F7F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="10" Padding="18,12" Margin="0,0,6,0"><StackPanel><TextBlock Text="KALICI VERİ" Foreground="#54708D" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="HomeSchoolCountText" Text="27 KURUM" Foreground="#031C38" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Kurum kayıtları" Foreground="#526277" FontSize="13.5"/></StackPanel></Border>
                                    <Border Background="#F7F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="10" Padding="18,12" Margin="3,0"><StackPanel><TextBlock Text="AKTİF FATURA" Foreground="#54708D" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="HomeInvoiceCountText" Text="0 KAYIT" Foreground="#031C38" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock x:Name="HomeInvoiceTypeText" Text="Tür: Henüz belirlenmedi" Foreground="#526277" FontSize="13.5"/></StackPanel></Border>
                                    <Border Background="#F7F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="10" Padding="18,12" Margin="6,0,0,0"><StackPanel><TextBlock Text="HYS KAPANIŞI" Foreground="#54708D" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="HomeArchiveCountText" Text="0 / 0 KAPALI" Foreground="#031C38" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Kapalı / toplam arşiv" Foreground="#526277" FontSize="13.5"/></StackPanel></Border>
                                </UniformGrid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="HomeMonthlyPeriodText" Text="BU AYIN MALİ ÖZETİ" Foreground="#031C38" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock Text="HYS ile kapatılan arşivlerde fatura tarihi esas alınır" Foreground="#6A7C90" FontSize="13.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <UniformGrid Columns="4" Margin="0,0,0,12">
                                    <Border Background="#F7F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,4,0"><StackPanel><TextBlock Text="FATURA SAYISI" Foreground="#54708D" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="HomeMonthlyInvoiceCountText" Text="0 kayıt" Foreground="#031C38" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Background="#F7F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="3,0"><StackPanel><TextBlock Text="FATURA TUTARI" Foreground="#54708D" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="HomeMonthlyPayableText" Text="0,00 TL" Foreground="#031C38" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Background="#FFF9EC" BorderBrush="#E8C067" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="3,0"><StackPanel><TextBlock Text="DAMGA VERGİSİ" Foreground="#8A681A" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="HomeMonthlyStampText" Text="0,00 TL" Foreground="#B7791F" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Background="#EFF9F3" BorderBrush="#A8D5B9" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="4,0,0,0"><StackPanel><TextBlock Text="ÖDEME TUTARI" Foreground="#34704B" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="HomeMonthlyPaymentText" Text="0,00 TL" Foreground="#248A50" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                                </UniformGrid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PremiumPanel}" CornerRadius="10" Padding="16" MinHeight="240">
                                        <StackPanel>
                                            <TextBlock Text="FATURA TÜRÜ DAĞILIMI" Style="{StaticResource PremiumSectionTitle}"/>
                                            <TextBlock Text="HYS ile kapalı arşivler • ödeme tutarına göre" Style="{StaticResource PremiumSectionSubtitle}" Margin="0,3,0,13"/>
                                            <Grid>
                                                <ItemsControl ItemsSource="{Binding HomeInvoiceTypeBars}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="9"/></Grid.RowDefinitions>
                                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="White" FontSize="14.5" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding CountLabel}" Foreground="#91ABC0" FontSize="13" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding AmountLabel}" Foreground="#D8E4EF" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                                                                <Grid Grid.Row="2"><Border Background="#173A58" CornerRadius="4"/><Border Background="{Binding BarBrush}" Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="4"/></Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="HomeInvoiceTypeEmptyText" Text="Henüz dağılım oluşturacak fatura yok." Foreground="#91ABC0" FontSize="14" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource PremiumPanel}" CornerRadius="10" Padding="16" MinHeight="240">
                                        <StackPanel>
                                            <TextBlock Text="SON 6 AY ÖDEME EĞİLİMİ" Style="{StaticResource PremiumSectionTitle}"/>
                                            <TextBlock Text="Fatura tarihine göre aylık ödeme toplamı" Style="{StaticResource PremiumSectionSubtitle}" Margin="0,3,0,13"/>
                                            <ItemsControl ItemsSource="{Binding HomeMonthlyTrendBars}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7" ToolTip="{Binding CountLabel}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
                                                            <Grid Grid.Column="1" Height="9" Margin="5,0,10,0"><Border Background="#173A58" CornerRadius="4"/><Border Background="{Binding BarBrush}" Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="4"/></Grid>
                                                            <TextBlock Grid.Column="2" Text="{Binding AmountLabel}" Foreground="#D8E4EF" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- FATURA GİRİŞİ -->
                        <ScrollViewer x:Name="InvoiceView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,16">
                                <TextBlock Text="FATURA GİRİŞİ" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Aktif liste tek fatura türüne kilitlenir; farklı fatura türleri aynı ödeme listesinde birleştirilemez." Style="{StaticResource PageSubtitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.06*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource PremiumPanel}" Padding="17">
                                        <StackPanel>
                                            <TextBlock Text="FATURA VE KURUM BİLGİLERİ" Style="{StaticResource PremiumSectionTitle}"/>
                                            <TextBlock Text="Yıldızlı alanlar ve ilgili hizmet numarası kayıt için zorunludur; VKN ile fatura no isteğe bağlıdır." Style="{StaticResource PremiumSectionSubtitle}" TextWrapping="Wrap" Margin="0,3,0,13"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0"><TextBlock Text="Kurum Türü *" Style="{StaticResource PremiumFieldLabel}"/><ComboBox x:Name="InstitutionTypeBox" Style="{StaticResource PremiumFieldComboBox}" SelectionChanged="InstitutionTypeBox_SelectionChanged"/></StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Okul / Kurum *" Style="{StaticResource PremiumFieldLabel}"/><ComboBox x:Name="InstitutionBox" Style="{StaticResource PremiumFieldComboBox}" DisplayMemberPath="Name" SelectionChanged="InstitutionBox_SelectionChanged"/></StackPanel>
                                                <StackPanel Grid.Row="2"><TextBlock Text="Fatura Türü *" Style="{StaticResource PremiumFieldLabel}"/><ComboBox x:Name="InvoiceTypeBox" Style="{StaticResource PremiumFieldComboBox}" SelectionChanged="InvoiceTypeBox_SelectionChanged" ToolTip="Aktif listedeki bütün faturalar aynı türde olmalıdır."/></StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Fatura No (isteğe bağlı)" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="InvoiceNumberBox" Style="{StaticResource PremiumFieldTextBox}" MaxLength="100" TextChanged="FormField_TextChanged"/></StackPanel>
                                                <StackPanel Grid.Row="4"><TextBlock Text="Vergi Kimlik No" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="VknBox" Style="{StaticResource PremiumFieldTextBox}" IsReadOnly="True"/></StackPanel>
                                                <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Hizmet / Tüketici No" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="ServiceNumberBox" Style="{StaticResource PremiumFieldTextBox}" IsReadOnly="True"/></StackPanel>
                                                <StackPanel Grid.Row="6"><TextBlock Text="Fatura Tarihi *" Style="{StaticResource PremiumFieldLabel}"/><DatePicker x:Name="InvoiceDatePicker" Style="{StaticResource PremiumDatePicker}" SelectedDateFormat="Short" SelectedDateChanged="FormDate_SelectedDateChanged"/></StackPanel>
                                                <StackPanel Grid.Row="6" Grid.Column="2"><TextBlock Text="Son Ödeme Tarihi *" Style="{StaticResource PremiumFieldLabel}"/><DatePicker x:Name="DueDatePicker" Style="{StaticResource PremiumDatePicker}" SelectedDateFormat="Short" SelectedDateChanged="FormDate_SelectedDateChanged"/></StackPanel>
                                                <StackPanel Grid.Row="8"><TextBlock Text="Ödenecek Tutar *" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="PayableAmountBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="MoneyInput_TextChanged" ToolTip="Örnek: 4.965,10"/></StackPanel>
