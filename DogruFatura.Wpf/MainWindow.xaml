                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="2" Padding="18" ClipToBounds="False" Style="{StaticResource PaymentMetricCard}" MinHeight="440">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Dağılım Detayı" Foreground="#FFD36F" FontSize="15" FontWeight="Bold"/>
                                                        <TextBlock Text="Tür bazında fatura adedi, ödeme tutarı ve toplam içindeki pay." Foreground="#C5D6E5" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,16"/>
                                                    </StackPanel>
                                                    <Grid Grid.Row="1">
                                                        <StackPanel x:Name="StatisticsDonutLegendPanel" VerticalAlignment="Top"/>
                                                        <StackPanel x:Name="StatisticsDonutEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="#C5D6E5" FontSize="38" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Dağılım Verisi Yok" Foreground="#FFD36F" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                                                            <TextBlock Text="Filtreleri değiştirerek başka bir dönem veya kurum seçebilirsiniz." Foreground="#C5D6E5" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <WrapPanel x:Name="StatisticsDetailActions" Grid.Row="2" Margin="0,16,0,0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <ScrollViewer x:Name="AboutView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Hakkında / Ayarlar" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="DoğruFatura · Fatura ödeme ve HYS belge takibi" Style="{StaticResource PageSubtitle}"/>
                                <Border Style="{StaticResource PaymentMetricCard}" Padding="18" Margin="0,0,0,16">
                                    <StackPanel x:Name="AboutIdentityPanel">
                                        <TextBlock Text="DoğruFatura" Foreground="#FFD36F" FontSize="26" FontWeight="Bold"/>
                                        <TextBlock Text="Geliştiren: Murat ÇALIMLIER" Foreground="White" FontSize="14" Margin="0,12,0,8"/>
                                        <TextBox x:Name="AboutVersionText" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,3" Style="{StaticResource CopyableInfo}"/>
                                        <TextBox x:Name="AboutRuntimeText" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="12.5" TextWrapping="Wrap" Style="{StaticResource CopyableInfo}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PaymentMetricCard}" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Ekran Ve Yerleşim" Foreground="#FFD36F" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Ekran profilini seçin. Pencere kullanılabilir alana sığar; form ve tablolar yerleşime uyarlanır." Foreground="#C5D6E5" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,16"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="DisplayProfileBox" Height="36" FontSize="14" DisplayMemberPath="Label" SelectionChanged="DisplayProfile_SelectionChanged"/>
                                            <Button x:Name="ApplyDisplayProfileButton" Grid.Column="2" Style="{StaticResource GoldActionButton}" Content="Uygula" IsEnabled="False" Click="ApplyDisplayProfile_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="DisplayProfileStatusText" Foreground="#C5D6E5" TextWrapping="Wrap" FontSize="13.0" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PaymentMetricCard}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Program Özellikleri" Foreground="#FFD36F" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Fatura girişi ve vergi hesabı&#10;Kurum ve hizmet numarası yönetimi&#10;Yetkili ve imza profilleri&#10;Ödeme listesi, PDF ve yazdırma&#10;Kaydedilmiş paketler ve HYS kapanışı&#10;Geçmiş harcamalar için istatistik ve Excel&#10;Veri bütünlüğü ve güvenlik yedekleri" Foreground="#D8E4EF" FontSize="14" LineHeight="30" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Expander Margin="0,8,0,0" Foreground="#031C38">
                                    <Expander.Header>
                                        <TextBlock Text="Gelişmiş / Destek" Foreground="#526277" FontSize="12.5" FontWeight="SemiBold"/>
                                    </Expander.Header>
                                    <Button Style="{StaticResource ModernButton}" Content="Tanılama paketi" HorizontalAlignment="Stretch" Margin="0,10,0,0" Background="#315371" Click="CreateDiagnosticPackage_Click" ToolTip="Destek için güvenli tanılama ZIP'i oluşturur. Fatura JSON/PDF içerikleri eklenmez; hata günlüklerindeki kişisel veri örüntüleri maskelenir." AutomationProperties.Name="Tanılama paketi oluştur" AutomationProperties.HelpText="Fatura JSON/PDF içeriklerini dışarıda bırakan ve hata günlüklerindeki kişisel veri örüntülerini maskeleyen destek paketi oluşturur."/>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="SecurityView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Güvenlik" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Veri bütünlüğü, yedekleme ve geri yükleme." Style="{StaticResource PageSubtitle}"/>
                                <Border Style="{StaticResource PremiumPanel}" Padding="18">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Right" Background="#173953" BorderBrush="#B78B42" BorderThickness="1" CornerRadius="12" Width="48" Height="48" Margin="12,0,0,0">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="#FFD36F" FontSize="26" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Veri Güvenliği" Style="{StaticResource PremiumSectionTitle}"/>
                                        </DockPanel>
                                        <TextBlock Text="Kayıtlar ile aktif ve arşiv PDF belgeleri birlikte korunur." Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <Border Background="#123D5F" BorderBrush="#365874" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,13,0,10">
                                            <StackPanel>
                                                <TextBlock x:Name="DataIntegrityText" Foreground="#62D99B" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="LastSafetyBackupText" Foreground="#B9CBDA" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="3" Margin="0,0,0,6">
                                            <Button Style="{StaticResource ModernButton}" Content="Kontrol et" Margin="0,0,6,0" Background="#425B76" Click="RunIntegrityCheck_Click"/>
                                            <Button Style="{StaticResource ModernButton}" Content="Yedek oluştur" Margin="3,0" Click="CreateSafetyBackup_Click"/>
                                            <Button Style="{StaticResource ModernButton}" Content="Geri yükle" Margin="6,0,0,0" Background="#8A5A12" Click="RestoreSafetyBackup_Click"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
