                                                                <Setter Property="Foreground" Value="#B7791F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SeverityLabel}" Value="Hata">
                                                                        <Setter Property="Foreground" Value="#C23A43"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Kontrol" Binding="{Binding Category}" Width="135"/>
                                                    <DataGridTextColumn Header="Bulgu" Binding="{Binding Title}" Width="*"/>
                                                    <DataGridTextColumn Header="Kurum" Binding="{Binding InstitutionName}" Width="175"/>
                                                    <DataGridTextColumn Header="Referans" Binding="{Binding Reference}" Width="125"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border x:Name="ControlEmptyState" Background="#F7F9FC" IsHitTestVisible="False">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Foreground="#43A66D" FontSize="40" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Görüntülenecek bulgu yok" Foreground="#315E45" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                                                    <TextBlock Text="Kayıtlar temiz olabilir veya geçerli filtreyle eşleşmiyor olabilir." Foreground="#728596" FontSize="13.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource PremiumPanel}" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="SEÇİLİ BULGU" Style="{StaticResource PremiumSectionTitle}"/>
                                                <TextBlock x:Name="ControlSelectedTitleText" Text="Seçili bulgu yok" Style="{StaticResource PremiumSectionSubtitle}" Margin="0,3,90,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border x:Name="ControlSelectedSeverityBadge" Background="#248A50" CornerRadius="10" Padding="11,5" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock x:Name="ControlSelectedSeverityText" Text="TEMİZ" Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <Border Grid.Row="1" Background="#061F39" BorderBrush="#365874" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,11,0,9">
                                            <TextBlock x:Name="ControlSelectedReferenceText" Text="Kontrol sonuçlarından bir kayıt seçin." Foreground="#D8E4EF" FontSize="13.5" TextWrapping="Wrap"/>
                                        </Border>
                                        <Border Grid.Row="2" Background="#082744" BorderBrush="#365874" BorderThickness="1" CornerRadius="9" Padding="14" MinHeight="150">
                                            <StackPanel>
                                                <TextBlock Text="AÇIKLAMA" Foreground="#91ABC0" FontSize="12.5" FontWeight="Bold"/>
                                                <TextBlock x:Name="ControlSelectedDetailText" Text="Bütün denetimler başarıyla tamamlandı." Foreground="White" FontSize="16" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                <Border Height="1" Background="#315371" Margin="0,16,0,13"/>
                                                <TextBlock Text="Kayda git düğmesi, ilgili fatura veya kurum ekranını açar; hiçbir kayıt otomatik değiştirilmez." Foreground="#AFC5D8" FontSize="13.5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ControlStatusBorder" Grid.Row="3" Background="#123B5B" BorderBrush="#365874" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,9,0,8">
                                            <TextBlock x:Name="ControlStatusText" Text="Kayıtlar denetleniyor." Style="{StaticResource StatusText}"/>
                                        </Border>
                                        <Button x:Name="ControlGoToButton" Grid.Row="4" Style="{StaticResource ModernButton}"
                                                Content="KAYDA GİT" Background="#2468D8" IsEnabled="False"
                                                Click="ControlGoTo_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <Grid x:Name="StatisticsView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="İSTATİSTİK" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="HYS ile kapanmış arşiv kayıtlarından kurum, yıl ve fatura türü bazında mali toplamları inceleyin." Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                                <Button Style="{StaticResource ModernButton}" Content="YENİLE" Width="120"
                                        Background="#248A50" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="RefreshStatistics_Click"/>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,9">
                                <Border Background="#F7F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="9" Padding="13,8" Margin="0,0,4,0">
                                    <StackPanel><TextBlock Text="ARŞİV" Foreground="#54708D" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="StatisticsArchiveCountText" Text="0 arşiv" Foreground="#031C38" FontSize="21.5" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                                <Border Background="#F7F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="9" Padding="13,8" Margin="3,0">
                                    <StackPanel><TextBlock Text="FATURA" Foreground="#54708D" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="StatisticsInvoiceCountText" Text="0 fatura" Foreground="#031C38" FontSize="21.5" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                                <Border Background="#F7F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="9" Padding="13,8" Margin="3,0">
                                    <StackPanel><TextBlock Text="KURUM" Foreground="#54708D" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="StatisticsInstitutionCountText" Text="0 kurum" Foreground="#031C38" FontSize="21.5" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                                <Border Background="#EFF9F3" BorderBrush="#A8D5B9" BorderThickness="1" CornerRadius="9" Padding="13,8" Margin="4,0,0,0">
                                    <StackPanel><TextBlock Text="TOPLAM ÖDEME" Foreground="#34704B" FontSize="12.5" FontWeight="Bold"/><TextBlock x:Name="StatisticsPaymentTotalText" Text="0,00 TL" Foreground="#248A50" FontSize="21.5" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Style="{StaticResource PremiumPanel}" Padding="12" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145"/><ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="160"/><ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="104"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Yıl" Style="{StaticResource PremiumFieldLabel}"/>
                                        <ComboBox x:Name="StatisticsYearFilterBox" Style="{StaticResource PremiumFieldComboBox}"
                                                  SelectionChanged="StatisticsFilter_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Kurum" Style="{StaticResource PremiumFieldLabel}"/>
                                        <ComboBox x:Name="StatisticsInstitutionFilterBox" Style="{StaticResource PremiumFieldComboBox}"
                                                  SelectionChanged="StatisticsFilter_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Fatura Türü" Style="{StaticResource PremiumFieldLabel}"/>
                                        <ComboBox x:Name="StatisticsTypeFilterBox" Style="{StaticResource PremiumFieldComboBox}"
                                                  SelectionChanged="StatisticsFilter_SelectionChanged"/>
                                    </StackPanel>
                                    <Button Grid.Column="6" Style="{StaticResource ModernButton}" Content="TEMİZLE"
                                            VerticalAlignment="Bottom" Background="#315371" Click="ClearStatisticsFilters_Click"/>
                                    <Border Grid.Row="1" Grid.ColumnSpan="7" Background="#123B5B" BorderBrush="#365874"
                                            BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,10,0,0">
                                        <TextBlock x:Name="StatisticsTotalsText"
                                                   Text="Fatura toplamı: 0,00 TL • KDV: 0,00 TL • Damga: 0,00 TL • Ödeme: 0,00 TL"
                                                   Style="{StaticResource StatusText}" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#F7F9FC" BorderBrush="#DCE5EE" BorderThickness="1" CornerRadius="10" Padding="10">
                                <Grid>
                                    <DataGrid x:Name="StatisticsGrid" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                                              IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                              CanUserSortColumns="True" CanUserReorderColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Kurum" Binding="{Binding InstitutionName}" Width="2*"/>
                                            <DataGridTextColumn Header="Yıl" Binding="{Binding Year}" Width="72"/>
                                            <DataGridTextColumn Header="Tür" Binding="{Binding InvoiceType}" Width="100"/>
                                            <DataGridTextColumn Header="Adet" Binding="{Binding InvoiceCount}" Width="68"/>
                                            <DataGridTextColumn Header="Fatura Tutarı" Binding="{Binding PayableTotal, StringFormat={}{0:N2} TL}" Width="125"/>
                                            <DataGridTextColumn Header="KDV" Binding="{Binding VatTotal, StringFormat={}{0:N2} TL}" Width="105"/>
                                            <DataGridTextColumn Header="Damga" Binding="{Binding StampDutyTotal, StringFormat={}{0:N2} TL}" Width="105"/>
                                            <DataGridTextColumn Header="Ödeme" Binding="{Binding PaymentTotal, StringFormat={}{0:N2} TL}" Width="125"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border x:Name="StatisticsEmptyState" Background="#F7F9FC" IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" Foreground="#9BB0C2" FontSize="42" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Seçili filtrelerde istatistik verisi yok" Foreground="#526277" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                            <TextBlock Text="İstatistikler HYS ile kapanmış arşiv kayıtlarındaki faturalardan hesaplanır." Foreground="#7A8B9E" FontSize="14.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ScrollViewer x:Name="AboutView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,16">
                                <TextBlock Text="HAKKINDA / GÜVENLİK" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Sürüm, veri sağlığı, yedekleme ve destek araçları." Style="{StaticResource PageSubtitle}"/>

                                <Grid Margin="0,8,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.88*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.12*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource PremiumPanel}" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="SÜRÜM / ÇALIŞMA ORTAMI" Style="{StaticResource PremiumSectionTitle}"/>
                                            <TextBlock x:Name="AboutVersionText" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,3"/>
                                            <TextBlock x:Name="AboutRuntimeText" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="13.5" TextWrapping="Wrap"/>
                                            <TextBlock Text="Teknik klasörler ve destek araçları Gelişmiş / Destek bölümündedir."
                                                       Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="12.5"
                                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource PremiumPanel}" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="VERİ GÜVENLİĞİ" Style="{StaticResource PremiumSectionTitle}"/>
                                            <TextBlock Text="Kayıtlar ile aktif ve arşiv PDF belgeleri birlikte korunur."
                                                       Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="13.5"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"/>

                                            <Border Background="#123D5F" BorderBrush="#365874" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,9" Margin="0,13,0,10">
                                                <StackPanel>
                                                    <TextBlock x:Name="DataIntegrityText" Foreground="#62D99B" FontSize="14"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="LastSafetyBackupText" Foreground="#B9CBDA" FontSize="12.5"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                                <Button Style="{StaticResource ModernButton}" Content="KONTROL ET"
                                                        Margin="0,0,6,0" Background="#425B76"
                                                        Click="RunIntegrityCheck_Click"/>
                                                <Button Style="{StaticResource ModernButton}" Content="YEDEK OLUŞTUR"
                                                        Margin="3,0" Click="CreateSafetyBackup_Click"/>
                                                <Button Style="{StaticResource ModernButton}" Content="GERİ YÜKLE"
                                                        Margin="6,0,0,0" Background="#8A5A12"
                                                        Click="RestoreSafetyBackup_Click"/>
                                            </UniformGrid>

                                            <Expander Margin="0,8,0,0" Foreground="White">
                                                <Expander.Header>
                                                    <TextBlock Text="GELİŞMİŞ / DESTEK" Foreground="#B9CBDA"
                                                               FontSize="13.5" FontWeight="SemiBold"/>
                                                </Expander.Header>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button Style="{StaticResource ModernButton}" Content="VERİ KLASÖRÜ"
                                                            Width="158" Margin="0,0,8,8" Background="#315371"
                                                            Click="OpenDataFolder_Click"/>
                                                    <Button Style="{StaticResource ModernButton}" Content="PDF KLASÖRÜ"
                                                            Width="158" Margin="0,0,8,8" Background="#315371"
                                                            Click="OpenDocumentFolder_Click"/>
                                                    <Button Style="{StaticResource ModernButton}" Content="YEDEK KLASÖRÜ"
                                                            Width="178" Margin="0,0,8,8" Background="#315371"
                                                            Click="OpenBackupFolder_Click"/>
                                                    <Button Style="{StaticResource ModernButton}" Content="LOG KLASÖRÜ"
                                                            Width="158" Margin="0,0,8,8" Background="#315371"
                                                            Click="OpenLogFolder_Click"/>
                                                    <Button Style="{StaticResource ModernButton}" Content="TANILAMA PAKETİ"
                                                            Width="190" Margin="0,0,8,8" Background="#315371"
                                                            Click="CreateDiagnosticPackage_Click"
                                                            ToolTip="Destek için tanılama ZIP'i oluşturur. Fatura verileri ve PDF belgeleri pakete eklenmez."
                                                            AutomationProperties.Name="Tanılama paketi oluştur"
                                                            AutomationProperties.HelpText="Fatura kayıtlarını ve PDF belgelerini içermeyen destek paketi oluşturur."/>
                                                </WrapPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource PremiumPanel}" Padding="22" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ÖZELLİKLER" Style="{StaticResource PremiumSectionTitle}"/>
                                        <TextBlock Text="DoğruFatura'nın günlük kullanım ve güvenlik yetenekleri kısa özetle aşağıdadır."
                                                   Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="14"
                                                   TextWrapping="Wrap" Margin="0,6,0,14"/>

                                        <UniformGrid Columns="2">
                                            <TextBlock Text="✓ Veri güvenliği ve bütünlük" Foreground="#D8E4EF" FontSize="15.5" Margin="0,4"/>
                                            <TextBlock Text="✓ Fatura giriş ve doğrulama" Foreground="#D8E4EF" FontSize="15.5" Margin="0,4"/>
                                            <TextBlock Text="✓ HYS ve işlem arşivi" Foreground="#D8E4EF" FontSize="15.5" Margin="0,4"/>
                                            <TextBlock Text="✓ Rapor, PDF ve yazdırma" Foreground="#D8E4EF" FontSize="15.5" Margin="0,4"/>
                                            <TextBlock Text="✓ Kontrol Merkezi ve denetim" Foreground="#D8E4EF" FontSize="15.5" Margin="0,4"/>
                                            <TextBlock Text="✓ Yedekleme, kurtarma ve destek" Foreground="#D8E4EF" FontSize="15.5" Margin="0,4"/>
                                        </UniformGrid>

                                        <Expander Margin="0,14,0,0" Foreground="White">
                                            <Expander.Header>
                                                <TextBlock Text="ÖZELLİKLER / TEKNİK BİLGİLER" Foreground="#B9CBDA"
                                                           FontSize="13.5" FontWeight="SemiBold"/>
                                            </Expander.Header>
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="✓ Tek örnek çalışma koruması ve açılış öz testi" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ Kalıcı okul/kurum, yetkili ve aktif fatura kayıtları" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ VKN, hizmet no, tarih, mükerrer kayıt ve vergi kontrolleri" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ Tek fatura türü politikası ve kontrollü düzenleme/silme" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ Elektrik kesinti tazminatı ve su damga vergisi istisnası" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ Yatay A4 rapor, çok sayfalı çıktı, PDF ve Windows yazdırma" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ HYS kapanışı, kalıcı arşiv ve geçmiş PDF içe aktarma" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ Arşiv–PDF eşitleme ve SHA-256 bütünlük kontrolü" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ Tam güvenlik yedeği, güvenli geri yükleme ve kurtarma" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ Veri, PDF, yedek, log ve tanılama destek araçları" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ Başta sıfır bulunan VKN ve hizmet numaraları metin olarak korunur" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                                <TextBlock Text="✓ Excel / Office çalışma bağımlılığı yoktur" Foreground="#D8E4EF" FontSize="14.5" Margin="0,3"/>
                                            </StackPanel>
                                        </Expander>

                                        <Border Height="1" Background="#365874" Margin="0,15"/>
                                        <TextBlock Text="Created by Murat ÇALIMLIER" Foreground="#FFB41F" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Viewbox>
</Window>
